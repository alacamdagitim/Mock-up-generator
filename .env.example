# Node 22 · Yalnızca sunucuda kullanılır. Tarayıcı paketine dahil edilmez.
PORT=3001
# Kalıcı ve yedeklenen bir disk dizini olmalı. Boşsa kayıt kapalıdır.
DESIGN_STORAGE_DIR=
# Erişilebilir HTTPS API adresi. Örn. https://design-api.magazaniz.com
PUBLIC_BASE_URL=
# Vercel: Storage bölümünden erişimi PRIVATE olan Blob deposunu projeye bağlayın.
# Bu değişkeni yalnız Vercel sunucu ortamına ekleyin; VITE_ öneki kullanmayın.
# Bağlantı kurulmadıysa /api/health storageConfigured:false döner ve satın alma kapalı kalır.
BLOB_READ_WRITE_TOKEN=
# Vercel'de PUBLIC_BASE_URL isteğe bağlıdır; verilmezse sabit production URL kullanılır.
# Tam origin listesi, virgülle ayrılır. Shopify mağazanızın özel alan adını ekleyin.
ALLOWED_ORIGINS=https://alacamdagitim.com,https://www.alacamdagitim.com,https://mock-up-generator-y265.vercel.app,http://localhost:5184,http://127.0.0.1:5184
