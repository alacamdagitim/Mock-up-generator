# Node 20.11+ · Yalnızca sunucuda kullanılır. Tarayıcı paketine dahil edilmez.
PORT=3001
# Kalıcı ve yedeklenen bir disk dizini olmalı. Boşsa kayıt kapalıdır.
DESIGN_STORAGE_DIR=
# Erişilebilir HTTPS API adresi. Örn. https://design-api.magazaniz.com
PUBLIC_BASE_URL=
# Tam origin listesi, virgülle ayrılır. Shopify mağazanızın özel alan adını ekleyin.
ALLOWED_ORIGINS=http://localhost:5184,http://127.0.0.1:5184,http://localhost:5173,http://127.0.0.1:5173
