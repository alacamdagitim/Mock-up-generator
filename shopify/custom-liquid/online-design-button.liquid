{% comment %}
  Alaçam Online design · ürün sayfasında tam ekran editör düğmesi.
  Gerekli: assets/alacam-launcher.js ve aynı derlemenin tüm alacam-* dosyaları.
  Snippet: render 'alacam-online-design-button', editor_product: product,
           api_base: 'https://design-api.magazaniz.com/api'
  Bir section içinde aynı ürün için birden fazla düğme varsa benzersiz instance_id verin.
  Custom Liquid bloğunda bu dosyanın tamamı doğrudan kullanılabilir.
{% endcomment %}
{% assign alacam_button_product = editor_product | default: product %}
{% if alacam_button_product != blank and alacam_button_product.id != blank %}
  {% assign alacam_button_instance = instance_id | default: block.id | default: 'button' %}
  {% capture alacam_button_config_id %}alacam-online-design-{{ section.id }}-{{ alacam_button_product.id }}-{{ alacam_button_instance }}{% endcapture %}
  {% capture alacam_button_config %}
  {
    "apiBase": {{ api_base | default: '/api' | json }},
    "productId": {{ alacam_button_product.id | append: '' | json }},
    "productTitle": {{ alacam_button_product.title | json }},
    "productDielineUrl": {{ alacam_button_product.metafields.custom.alacam_dieline.value.url | default: '' | json }},
    "productImage": {% if alacam_button_product.featured_image %}{{ alacam_button_product.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %},
    "initialVariantId": {{ alacam_button_product.selected_or_first_available_variant.id | json }},
    "libraryKey": {{ 'alacam:library:v1:product:' | append: alacam_button_product.id | json }},
    "storageKey": {{ 'alacam:v1:product:' | append: alacam_button_product.id | json }},
    "cartRoot": {{ routes.root_url | json }},
    "variants": [{% for alacam_variant in alacam_button_product.variants %}{"id": {{ alacam_variant.id | json }}, "title": {{ alacam_variant.title | json }}, "available": {{ alacam_variant.available | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  }
  {% endcapture %}
  <button
    type="button"
    data-alacam-launcher-button
    data-alacam-open="{{ alacam_button_config_id | strip | escape }}"
    aria-haspopup="dialog"
  >Online design</button>
  <script id="{{ alacam_button_config_id | strip | escape }}" type="application/json">{{ alacam_button_config | replace: '<', '\u003c' }}</script>
  <script src="{{ 'alacam-launcher.js' | asset_url }}" data-alacam-editor-src="{{ 'alacam-editor.js' | asset_url }}" type="module"></script>
{% else %}
  <p data-alacam-launcher-message role="status">Alaçam Online design: Bu düğmeyi bir ürün şablonuna ekleyin veya snippet'e editor_product parametresiyle bir ürün verin.</p>
{% endif %}
<style>
  button[data-alacam-launcher-button] {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    max-width: 100%;
    padding: 11px 24px;
    border: 1px solid #191919;
    border-radius: 8px;
    background: #191919;
    color: #fff;
    font: 500 14px/20px -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
  }
  button[data-alacam-launcher-button]:hover { background: #333; }
  button[data-alacam-launcher-button]:focus-visible { outline: 2px solid #8f45ff; outline-offset: 3px; }
  button[data-alacam-launcher-button]:disabled { opacity: .55; cursor: wait; }
  [data-alacam-launcher-message] {
    color: #a52620;
    font: 400 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
</style>
