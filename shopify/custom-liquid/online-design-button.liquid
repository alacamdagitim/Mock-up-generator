{% comment %}
  Alaçam Online tasarım · ürün sayfasında tam ekran editör düğmesi.
  Gerekli: assets/alacam-launcher.js ve aynı derlemenin tüm alacam-* dosyaları.
  Snippet: render 'alacam-online-design-button', editor_product: product,
           api_base: 'https://design-api.magazaniz.com/api'
  Bir section içinde aynı ürün için birden fazla düğme varsa benzersiz instance_id verin.
  Custom Liquid bloğunda bu dosyanın tamamı doğrudan kullanılabilir.
{% endcomment %}
{% assign alacam_button_product = editor_product | default: product %}
{% if alacam_button_product != blank and alacam_button_product.id != blank %}
  {% assign alacam_button_instance = instance_id | default: block.id | default: 'button' %}
  {% capture alacam_button_config_id %}alacam-online-design-{{ section.id }}-{{ alacam_button_product.id }}-{{ alacam_button_instance }}{% endcapture %}
  {% assign alacam_model_file = alacam_button_product.metafields.custom['3b_glb_dosyasi'].value %}
  {% assign alacam_model_url = alacam_model_file.url | default: '' %}
  {% if alacam_model_url == blank and alacam_model_file.sources != blank %}
    {% assign alacam_glb_source = alacam_model_file.sources | where: 'format', 'glb' | first %}
    {% assign alacam_model_url = alacam_glb_source.url | default: '' %}
  {% endif %}
  {% assign alacam_dieline_file = alacam_button_product.metafields.custom['bicak_i_zi'].value %}
  {% assign alacam_dieline_url = alacam_dieline_file.url | default: alacam_dieline_file.src | default: '' %}
  {% capture alacam_button_config %}
  {
    "apiBase": {{ api_base | default: '/api' | json }},
    "productId": {{ alacam_button_product.id | append: '' | json }},
    "productTitle": {{ alacam_button_product.title | json }},
    "productModelUrl": {{ alacam_model_url | json }},
    "productDielineUrl": {{ alacam_dieline_url | json }},
    "productImage": {% if alacam_button_product.featured_image %}{{ alacam_button_product.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %},
    "initialVariantId": {{ alacam_button_product.selected_or_first_available_variant.id | json }},
    "libraryKey": {{ 'alacam:library:v1:product:' | append: alacam_button_product.id | json }},
    "storageKey": {{ 'alacam:v1:product:' | append: alacam_button_product.id | json }},
    "cartRoot": {{ routes.root_url | json }},
    "variants": [{% for alacam_variant in alacam_button_product.variants %}{"id": {{ alacam_variant.id | json }}, "title": {{ alacam_variant.title | json }}, "available": {{ alacam_variant.available | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  }
  {% endcapture %}
  <div data-alacam-design-launcher>
    <button
      type="button"
      data-alacam-launcher-button
      data-alacam-open="{{ alacam_button_config_id | strip | escape }}"
      aria-haspopup="dialog"
    >
      <svg data-alacam-design-icon xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="m15 5 4 4M4 20l4.5-1L20 7.5a2.8 2.8 0 0 0-4-4L4.5 15Z" />
      </svg>
      <span>Online tasarla</span>
    </button>
    {% if alacam_dieline_url != blank %}
      <a
        data-alacam-dieline-link
        href="{{ alacam_dieline_url | escape }}"
        target="_blank"
        rel="noopener noreferrer"
        download
      >Bıçak izini indir</a>
    {% endif %}
  </div>
  <script id="{{ alacam_button_config_id | strip | escape }}" type="application/json">{{ alacam_button_config | replace: '<', '\u003c' }}</script>
  <script src="{{ 'alacam-launcher.js' | asset_url }}" data-alacam-editor-src="{{ 'alacam-editor.js' | asset_url }}" type="module"></script>
{% else %}
  <p data-alacam-launcher-message role="status">Alaçam Online tasarım: Bu düğmeyi bir ürün şablonuna ekleyin veya snippet'e editor_product parametresiyle bir ürün verin.</p>
{% endif %}
<style>
  [data-alacam-design-launcher] {
    display: grid;
    gap: 14px;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  [data-alacam-design-launcher] button[data-alacam-launcher-button] {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 48px;
    padding: 10px 24px;
    border: 2px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(#fff, #fff) padding-box,
      conic-gradient(from 0deg, #ff004c 0deg, #ffac00 28deg, #d8ff00 54deg, #35ff4d 86deg, #14ff5a 140deg, #00e8da 180deg, #0000ff 202deg, #9000ff 248deg, #be00ce 280deg, #be00ce 320deg, #ff004c 360deg) border-box;
    color: #191919;
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    line-height: 24px;
    letter-spacing: -.35px;
    text-transform: none;
    text-align: center;
    text-decoration: none;
    box-shadow: none;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  [data-alacam-design-launcher] button[data-alacam-launcher-button] [data-alacam-design-icon] {
    display: block;
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    color: inherit;
    pointer-events: none;
  }
  [data-alacam-design-launcher] button[data-alacam-launcher-button]::before,
  [data-alacam-design-launcher] button[data-alacam-launcher-button]::after,
  [data-alacam-design-launcher] a[data-alacam-dieline-link]::before,
  [data-alacam-design-launcher] a[data-alacam-dieline-link]::after {
    content: none;
    display: none;
  }
  [data-alacam-design-launcher] button[data-alacam-launcher-button]:hover {
    color: #191919;
    filter: brightness(.985);
  }
  [data-alacam-design-launcher] button[data-alacam-launcher-button]:disabled {
    opacity: .55;
    cursor: wait;
  }
  [data-alacam-design-launcher] a[data-alacam-dieline-link] {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    justify-self: end;
    max-width: 100%;
    min-height: 24px;
    color: #333;
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: -.15px;
    text-align: right;
    text-transform: none;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
    cursor: pointer;
    touch-action: manipulation;
  }
  [data-alacam-design-launcher] a[data-alacam-dieline-link]:hover { color: #191919; }
  [data-alacam-design-launcher] button[data-alacam-launcher-button]:focus-visible,
  [data-alacam-design-launcher] a[data-alacam-dieline-link]:focus-visible {
    outline: 2px solid #8f45ff;
    outline-offset: 4px;
  }
  @media (max-width: 749px) {
    [data-alacam-design-launcher] { gap: 8px; }
    [data-alacam-design-launcher] a[data-alacam-dieline-link] { min-height: 44px; }
  }
  @media (forced-colors: active) {
    [data-alacam-design-launcher] button[data-alacam-launcher-button] {
      border-color: ButtonText;
      background: Canvas;
      color: ButtonText;
    }
  }
  [data-alacam-launcher-message] {
    color: #a52620;
    font: 400 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
</style>
