# Separate persistent worker. Never put this token in Liquid or Vercel client env.
PSD_PORT=3002
# Production container: 0.0.0.0, locally 127.0.0.1
PSD_HOST=127.0.0.1
PSD_ADMIN_TOKEN=
PSD_DATA_DIR=data/psd-service
# Production https://mockup-api.example.com ; local Vite proxy /mockup-worker
PSD_PUBLIC_BASE=/mockup-worker
PSD_ALLOWED_ORIGINS=http://127.0.0.1:5184,http://localhost:5184,https://mock-up-generator-y265.vercel.app
# 8 GiB; includes sources + prepared assets
PSD_STORAGE_QUOTA_BYTES=8589934592
PSD_JOB_TIMEOUT_MS=600000
PSD_PYTHON=python3
